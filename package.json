{
  "name": "field-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Educational magnet field experiments",
  "scripts": {
    "dev": "vite",
    "serve": "vite --host 127.0.0.1 --port 8765",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "node --import tsx test.mjs && node --import tsx design-test.mjs && node --import tsx playground-test.mjs && node --import tsx integrated-test.mjs && node --import tsx compute-test.mjs",
    "test:browser": "playwright test",
    "test": "npm run test:unit && npm run test:browser",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run build",
    "test:production": "npm run build && playwright test --config=playwright.production.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
